    "test:walk": "node --test scripts/world-walk.test.mjs",
    "test:place-actions": "node --test scripts/place-actions.test.mjs",
    "test:place-events": "node --test scripts/place-events.test.mjs",
    "test:memory": "node --test scripts/world-memory.test.mjs",
    "test:favorite": "node --test scripts/world-favorite.test.mjs",
    "test:favorite-suggestion": "node --test scripts/favorite-suggestion.test.mjs",
    "test:habits": "node --test scripts/world-habits.test.mjs",
    "test:patterns": "node --test scripts/world-patterns.test.mjs",
    "test:pattern-reactions": "node --test scripts/world-pattern-reactions.test.mjs",
    "test:pattern-preferences": "node --test scripts/world-pattern-preferences.test.mjs",
    "test:microchoices": "node --test scripts/world-microchoices.test.mjs",
    "test:personalization": "node --test scripts/world-personalization.test.mjs",
    "test:place-personalization": "node --test scripts/world-place-personalization.test.mjs",
