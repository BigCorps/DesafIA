{
  "name": "desafia",
  "private": true,
  "version": "0.6.0",
  "description": "DesafIA — pequenos desafios, grandes hábitos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check.mjs && npm run test:notifications && npm run test:companion && npm run test:adventures && npm run test:games && npm run test:qa && npm run test:world && npm run test:places && npm run test:walk && npm run test:place-actions && npm run test:place-events && npm run test:memory && npm run test:favorite",
    "icons": "python3 brand/gerar_icones.py",
    "test:notifications": "node --test scripts/notifications.test.mjs",
    "test:companion": "node --test scripts/companion*.test.mjs",
    "test:adventures": "node --test scripts/adventures.test.mjs",
    "test:games": "node --test scripts/games-plus.test.mjs",
    "test:qa": "node --test scripts/qa-state.test.mjs",
    "test:world": "node --test scripts/world-life.test.mjs scripts/world-visual.test.mjs",
    "test:places": "node --test scripts/world-places.test.mjs",
    "test:walk": "node --test scripts/world-walk.test.mjs",
    "test:place-actions": "node --test scripts/place-actions.test.mjs",
    "test:place-events": "node --test scripts/place-events.test.mjs",
    "test:memory": "node --test scripts/world-memory.test.mjs",
    "test:favorite": "node --test scripts/world-favorite.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "vite": "7.3.6"
  }
}
